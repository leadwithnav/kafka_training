{"name": "postgres-customers-connector", "config": {"connector.class": "io.confluent.connect.jdbc.JdbcSourceConnector", "connection.url": "jdbc:postgresql://postgres:5432/demo_db", "connection.user": "demo_user", "connection.password": "demo_password", "mode": "incrementing", "incrementing.column.name": "id", "poll.interval.ms": "60000", "batch.max.rows": "100", "table.whitelist": "customers", "topic.prefix": "customers-", "quote.sql.identifiers": "always", "numeric.precision.mapping": "true", "transforms": "AddValueTs,SourceDbField,ValueToKey", "transforms.AddValueTs.type": "org.apache.kafka.connect.transforms.InsertField$Value", "transforms.AddValueTs.timestamp.field": "ingestion_timestamp", "transforms.SourceDbField.type": "org.apache.kafka.connect.transforms.InsertField$Value", "transforms.SourceDbField.static.field": "source_system", "transforms.SourceDbField.static.value": "postgres", "transforms.ValueToKey.type": "org.apache.kafka.connect.transforms.ValueToKey", "transforms.ValueToKey.fields": "id", "tasks.max": "1"}}